# Разработать двумерный массив, содержащий 5 записей, подходящих под критерии: порядковый
# номер,фамилия, гендер, возраст и пенсия. Посчитайте общую сумму выплат пенсии у людей,
# чей возраст больше 70.
Matrica = [
    [1, "Иванов", "М", 64, 1000],
    [2, "Сидоров", "М", 71, 1500],
    [3, "Петрова", "Ж", 69, 3000],
    [4, "Федоров", "М", 73, 2500],
    [5, "Иванова", "Ж", 68, 1200]
]

for x in Matrica: #вывод матрицы
   print(x)

sum = 0
with open('C:/Users/исп-31.RSSK/Desktop/пиад/матрица.txt', 'w', encoding='utf-8') as file:
    #w - запись в файл
    for row in Matrica:
        line = ' '.join(f'{str(x):<9}' for x in row)
        file.write(line + '\n')
        if row[3] > 70:
            sum += row[4]
    file.write(f"Сумма: {sum}")
    file.close()
print(f"Сумма: {sum}")
